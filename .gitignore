# Talos-generated machine configurations and administrative credentials.
# Keep reusable, non-secret patches outside this generated directory.
/configs/
talosconfig
talosconfig.*
kubeconfig
kubeconfig.*
secrets.yaml
secrets.yml
controlplane.yaml
worker.yaml

# Local Terraform provider/module cache
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Saved plans contain a copy of state and can contain plaintext secrets
*.tfplan
tfplan
tfplan.*
planout

# Ignore CLI configuration files
.terraformrc
terraform.rc
credentials.tfrc.json

# Optional: ignore graph output files generated by `terraform graph`
# *.dot

# Downloaded VM images and other large machine artifacts
*.qcow2
*.iso
*.img
*.raw

# Logs, packet captures, and local troubleshooting screenshots
*.log
*.pcap
*.pcapng
/image*.png

# Local environment files and private key containers
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# Workstation/editor/agent metadata
.idea/
.vscode/
.agents/
.codex/

# OS metadata
.DS_Store
Thumbs.db
